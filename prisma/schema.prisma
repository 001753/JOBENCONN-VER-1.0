generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum CapabilityState {
  PLANNED
  NOT_IMPLEMENTED
  VERIFICATION_REQUIRED
  DEGRADED
  LIVE_VERIFIED
  DEPRECATED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  EXPIRED
}

enum AwsConnectionStatus {
  PENDING
  ACTIVE
  ERROR
  REVOKED
}

enum AwsAccountStatus {
  ACTIVE
  ERROR
  REVOKED
}

enum AwsRegionStatus {
  AVAILABLE
  UNAVAILABLE
}

enum AwsResourceStatus {
  ACTIVE
  STALE
  DELETED
}

enum DiscoveryRunStatus {
  QUEUED
  RUNNING
  CANCELLING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  COMPLETED
  CANCELLED
  DEAD_LETTER
}

enum SecurityFindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum SecurityFindingStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum EvidenceType {
  PROVIDER_RESPONSE
  SCAN_CHECK
  INVENTORY_SNAPSHOT
  CONFIGURATION
}

enum EvidenceIntegrityStatus {
  VALID
  INTEGRITY_FAILED
}

enum EvidenceLegalHoldStatus {
  NONE
  ACTIVE
  RELEASED
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  externalIdentityRef String?             @unique @db.VarChar(255)
  email               String?             @db.VarChar(320)
  status              UserStatus          @default(ACTIVE)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  memberships         Membership[]
  invitationsAccepted Invitation[]        @relation("InvitationAcceptedBy")
  auditEvents         AuditEvent[]        @relation("AuditActor")
  scanRunsRequested   SecurityScanRun[]   @relation("ScanRequestedBy")
  idempotencyRecords  IdempotencyRecord[]
  sessions            Session[]
  evidenceHoldsCreated EvidenceLegalHold[] @relation("EvidenceHoldCreatedBy")
  evidenceHoldsReleased EvidenceLegalHold[] @relation("EvidenceHoldReleasedBy")
  domainEvents        DomainEvent[]

  @@index([status])
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tokenDigest          String    @unique @db.VarChar(128)
  csrfTokenDigest      String    @db.VarChar(128)
  activeOrganizationId String?   @db.Uuid
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt            DateTime  @db.Timestamptz(3)
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  version              Int       @default(1)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String              @db.VarChar(200)
  slug                String              @unique @db.VarChar(120)
  status              OrganizationStatus  @default(ACTIVE)
  homeRegion          String?             @db.VarChar(80)
  dataResidencyPolicy String?             @db.VarChar(120)
  locale              String?             @db.VarChar(32)
  timezone            String?             @db.VarChar(64)
  currency            String?             @db.VarChar(3)
  taxProfile          String?             @db.VarChar(120)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(3)
  memberships         Membership[]
  invitations         Invitation[]
  auditEvents         AuditEvent[]
  capabilityRecords   CapabilityRecord[]
  idempotencyRecords  IdempotencyRecord[]
  awsConnections      AwsConnection[]
  awsAccounts         AwsAccount[]
  awsResources        AwsResource[]
  discoveryRuns       DiscoveryRun[]
  securityFindings    SecurityFinding[]
  securityScanRuns    SecurityScanRun[]
  scanJobs            ScanJob[]
  scanCheckOutcomes   ScanCheckOutcome[]
  controlResults      ControlResult[]
  scanEvents          ScanEvent[]
  scanSchedules       ScanSchedule[]
  evidences           Evidence[]
  observedFacts       ObservedFact[]
  evidenceLegalHolds  EvidenceLegalHold[]
  domainEvents        DomainEvent[]

  @@index([status])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           String           @db.VarChar(80)
  status         MembershipStatus @default(ACTIVE)
  version        Int              @default(1)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, status])
  @@index([userId, status])
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  invitedEmail     String           @db.VarChar(320)
  role             String           @db.VarChar(80)
  tokenDigest      String           @unique @db.VarChar(128)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @db.Timestamptz(3)
  acceptedAt       DateTime?        @db.Timestamptz(3)
  revokedAt        DateTime?        @db.Timestamptz(3)
  acceptedByUserId String?          @db.Uuid
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  acceptedBy       User?            @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([invitedEmail, organizationId])
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  actorUserId    String?       @db.Uuid
  organizationId String?       @db.Uuid
  action         String        @db.VarChar(160)
  purpose        String        @db.VarChar(160)
  targetType     String?       @db.VarChar(120)
  targetId       String?       @db.VarChar(255)
  result         AuditResult
  reason         String?       @db.VarChar(500)
  correlationId  String        @db.VarChar(128)
  metadata       Json          @default("{}")
  schemaVersion  Int           @default(1)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([correlationId])
}

model CapabilityRecord {
  id                  String          @id @default(uuid()) @db.Uuid
  organizationId      String?         @db.Uuid
  capabilityId        String          @unique @db.VarChar(160)
  module              String          @db.VarChar(120)
  version             String          @db.VarChar(80)
  state               CapabilityState
  sourceOfTruth       String          @db.VarChar(255)
  verificationStatus  String          @db.VarChar(120)
  proofReference      String?         @db.VarChar(500)
  dependencyReference String?         @db.VarChar(500)
  reviewer            String?         @db.VarChar(255)
  verifiedAt          DateTime?       @db.Timestamptz(3)
  expiresAt           DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  organization        Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([module, state])
  @@index([organizationId, module])
}

model IdempotencyRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String?           @db.Uuid
  scopeKey           String            @db.VarChar(160)
  key                String            @db.VarChar(255)
  actorUserId        String?           @db.Uuid
  operationName      String            @db.VarChar(160)
  requestFingerprint String            @db.VarChar(128)
  status             IdempotencyStatus @default(IN_PROGRESS)
  resultReference    String?           @db.VarChar(500)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt          DateTime          @db.Timestamptz(3)
  version            Int               @default(1)
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor              User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([scopeKey, key])
  @@index([organizationId, key])
  @@index([expiresAt, status])
}

model AwsConnection {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @db.Uuid
  name              String              @db.VarChar(160)
  credentialSource  String              @db.VarChar(80)
  roleArn           String?             @db.VarChar(2048)
  externalIdDigest  String?             @db.VarChar(128)
  status            AwsConnectionStatus @default(PENDING)
  awsAccountId      String?             @db.VarChar(12)
  callerArn         String?             @db.VarChar(2048)
  callerUserId      String?             @db.VarChar(512)
  lastErrorCategory String?             @db.VarChar(80)
  scanFailureStreak Int                 @default(0)
  lastVerifiedAt    DateTime?           @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accounts          AwsAccount[]
  resources         AwsResource[]
  discoveryRuns     DiscoveryRun[]
  securityScanRuns  SecurityScanRun[]
  evidenceSources   Evidence[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model AwsAccount {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  connectionId     String            @db.Uuid
  awsAccountId     String            @db.VarChar(12)
  alias            String?           @db.VarChar(200)
  status           AwsAccountStatus  @default(ACTIVE)
  lastVerifiedAt   DateTime?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  connection       AwsConnection     @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  regions          AwsRegion[]
  resources        AwsResource[]
  discoveryRuns    DiscoveryRun[]
  securityFindings SecurityFinding[]
  securityScanRuns SecurityScanRun[]
  scanJobs        ScanJob[]
  scanSchedules   ScanSchedule[]

  @@unique([organizationId, awsAccountId])
  @@index([connectionId, status])
}

model ScanSchedule {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  accountId      String       @db.Uuid
  name           String       @db.VarChar(160)
  frequency      String       @db.VarChar(32)
  localTime      String       @db.VarChar(5)
  timezone       String       @db.VarChar(64)
  paused         Boolean      @default(false)
  nextRunAt      DateTime?    @db.Timestamptz(3)
  lastRunAt      DateTime?    @db.Timestamptz(3)
  lastRunId      String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        AwsAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, name])
  @@index([paused, nextRunAt])
  @@index([organizationId, accountId, paused])
}

model AwsRegion {
  id               String          @id @default(uuid()) @db.Uuid
  accountId        String          @db.Uuid
  regionCode       String          @db.VarChar(64)
  regionName       String?         @db.VarChar(160)
  status           AwsRegionStatus @default(AVAILABLE)
  lastDiscoveredAt DateTime?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  account          AwsAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, regionCode])
  @@index([regionCode, status])
}

model AwsResource {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  accountId      String            @db.Uuid
  connectionId   String            @db.Uuid
  region         String            @db.VarChar(64)
  service        String            @db.VarChar(80)
  resourceType   String            @db.VarChar(120)
  resourceId     String            @db.VarChar(512)
  resourceArn    String?           @db.VarChar(2048)
  resourceName   String?           @db.VarChar(512)
  status         AwsResourceStatus @default(ACTIVE)
  tags           Json              @default("{}")
  metadata       Json              @default("{}")
  firstSeenAt    DateTime          @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime          @default(now()) @db.Timestamptz(3)
  discoveredAt   DateTime          @default(now()) @db.Timestamptz(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        AwsAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  connection     AwsConnection     @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  findings       SecurityFinding[]

  @@unique([organizationId, accountId, region, service, resourceType, resourceId])
  @@index([organizationId, accountId, status])
  @@index([service, resourceType, region])
}

model DiscoveryRun {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @db.Uuid
  accountId           String             @db.Uuid
  connectionId        String             @db.Uuid
  status              DiscoveryRunStatus @default(QUEUED)
  idempotencyKey      String?            @unique @db.VarChar(255)
  startedAt           DateTime?
  finishedAt          DateTime?
  regionsAttempted    Int                @default(0)
  regionsSucceeded    Int                @default(0)
  regionsFailed       Int                @default(0)
  resourcesDiscovered Int                @default(0)
  resourcesUpdated    Int                @default(0)
  resourcesStale      Int                @default(0)
  errorCount          Int                @default(0)
  errors              Json               @default("[]")
  correlationId       String             @db.VarChar(128)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account             AwsAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  connection          AwsConnection      @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  securityScanRuns    SecurityScanRun[]
  securityFindings    SecurityFinding[]

  @@index([organizationId, status, createdAt])
  @@index([accountId, createdAt])
}

model SecurityScanRun {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid
  accountId            String             @db.Uuid
  connectionId         String             @db.Uuid
  requestedByUserId    String?            @db.Uuid
  discoveryRunId       String?            @db.Uuid
  status               DiscoveryRunStatus @default(RUNNING)
  triggerType          String             @default("MANUAL") @db.VarChar(32)
  idempotencyKey       String             @unique @db.VarChar(255)
  activeKey            String?            @unique @db.VarChar(120)
  snapshotFingerprint  String             @db.VarChar(128)
  startedAt            DateTime?          @db.Timestamptz(3)
  finishedAt           DateTime?
  durationMs           Int?
  totalResources       Int                @default(0)
  evaluatedResources   Int                @default(0)
  insufficientEvidence Int                @default(0)
  failedResources      Int                @default(0)
  totalChecks          Int?
  completedChecks      Int                @default(0)
  failedChecks         Int                @default(0)
  skippedChecks        Int                @default(0)
  rulesEvaluated       Int                @default(0)
  findingsCreated      Int                @default(0)
  findingsResolved     Int                @default(0)
  retryCount           Int                @default(0)
  lastErrorCategory    String?            @db.VarChar(80)
  lastError            String?             @db.VarChar(500)
  cancelRequestedAt    DateTime?
  terminalReason       String?            @db.VarChar(255)
  leaseOwner           String?            @db.VarChar(128)
  leaseAcquiredAt      DateTime?
  leaseExpiresAt       DateTime?
  ruleErrors           Json               @default("[]")
  correlationId        String             @db.VarChar(128)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @db.Timestamptz(3)
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account              AwsAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  connection           AwsConnection      @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  requestedBy          User?              @relation("ScanRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  discoveryRun         DiscoveryRun?      @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  findings             SecurityFinding[]
  job                  ScanJob?
  outcomes             ScanCheckOutcome[]
  controlResults       ControlResult[]
  events               ScanEvent[]
  evidences            Evidence[]

  @@index([organizationId, accountId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, connectionId, status])
  @@index([leaseExpiresAt, status])
}

model ScanJob {
  id             String        @id @default(uuid()) @db.Uuid
  scanRunId      String        @unique @db.Uuid
  organizationId String        @db.Uuid
  accountId      String        @db.Uuid
  status         ScanJobStatus @default(QUEUED)
  attempt        Int           @default(0)
  availableAt    DateTime      @default(now()) @db.Timestamptz(3)
  leasedAt       DateTime?
  leaseExpiresAt DateTime?
  workerId       String?       @db.VarChar(128)
  lastError      String?       @db.VarChar(500)
  correlationId  String        @db.VarChar(128)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account        AwsAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  scanRun        SecurityScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([leaseExpiresAt, status])
  @@index([scanRunId])
}

model ScanCheckOutcome {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  scanRunId        String   @db.Uuid
  checkId          String   @db.VarChar(120)
  checkVersion     String   @db.VarChar(32)
  resourceIdentity String   @db.VarChar(512)
  status           String   @db.VarChar(32)
  startedAt        DateTime @db.Timestamptz(3)
  finishedAt       DateTime @db.Timestamptz(3)
  durationMs       Int
  errorClass       String?  @db.VarChar(80)
  errorMessage     String?  @db.VarChar(500)
  attempt          Int      @default(1)
  correlationId    String   @db.VarChar(128)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scanRun          SecurityScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  evidences        Evidence[]
  controlResults   ControlResult[]

  @@unique([scanRunId, checkId, checkVersion, resourceIdentity, attempt])
  @@index([organizationId, scanRunId, createdAt])
  @@index([scanRunId, resourceIdentity])
}

model ControlResult {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  scanRunId          String             @db.Uuid
  scanCheckOutcomeId String?            @db.Uuid
  evidenceId         String?            @db.Uuid
  checkId            String             @db.VarChar(120)
  checkVersion       String             @db.VarChar(32)
  evaluatorVersion   String             @db.VarChar(32)
  provider           String             @db.VarChar(80)
  service            String             @db.VarChar(80)
  operation          String             @db.VarChar(160)
  resourceKey        String             @db.VarChar(512)
  status             String             @db.VarChar(32)
  observedAt         DateTime
  coverage           String             @db.VarChar(500)
  dataQuality        String             @db.VarChar(80)
  message            String             @db.VarChar(1000)
  errorCode          String?            @db.VarChar(80)
  evidenceHash       String?            @db.VarChar(64)
  canonicalizationVersion String?       @db.VarChar(32)
  provenance         Json               @default("{}")
  remediation        Json?
  soc2Mapping        Json?
  attempt            Int                @default(1)
  correlationId      String             @db.VarChar(128)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scanRun            SecurityScanRun    @relation(fields: [scanRunId], references: [id], onDelete: Cascade)
  scanCheckOutcome   ScanCheckOutcome?  @relation(fields: [scanCheckOutcomeId], references: [id], onDelete: SetNull)
  evidence           Evidence?          @relation(fields: [evidenceId], references: [id], onDelete: SetNull)

  @@unique([scanRunId, checkId, checkVersion, resourceKey, attempt])
  @@index([organizationId, checkId, status, observedAt])
  @@index([organizationId, resourceKey, observedAt])
}

model Evidence {
  id                       String                   @id @default(uuid()) @db.Uuid
  organizationId           String                   @db.Uuid
  sourceIntegrationId      String?                  @db.Uuid
  scanRunId                String?                  @db.Uuid
  scanCheckOutcomeId       String?                  @db.Uuid
  findingId                String?                  @db.Uuid
  controlStatusId          String?                  @db.Uuid
  type                     EvidenceType
  provider                 String                   @db.VarChar(80)
  storageRef               String                   @unique @db.VarChar(512)
  storageUrl               String?                  @db.VarChar(2048)
  storageVersionId         String?                  @db.VarChar(255)
  contentHash              String                   @db.VarChar(64)
  canonicalizationVersion  String                   @db.VarChar(32)
  schemaVersion            String                   @db.VarChar(80)
  providerRequestId        String?                  @db.VarChar(255)
  sourceEndpoint           String?                  @db.VarChar(2048)
  collectedAt              DateTime                 @db.Timestamptz(3)
  retentionUntil           DateTime                 @db.Timestamptz(3)
  immutable                Boolean                  @default(true)
  integrityStatus          EvidenceIntegrityStatus @default(VALID)
  integrityVerifiedAt      DateTime?                @db.Timestamptz(3)
  integrityFailureReason   String?                  @db.VarChar(255)
  legalHoldStatus          EvidenceLegalHoldStatus @default(NONE)
  supersedesEvidenceId     String?                  @db.Uuid
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceIntegration        AwsConnection?           @relation(fields: [sourceIntegrationId], references: [id], onDelete: Restrict)
  scanRun                  SecurityScanRun?         @relation(fields: [scanRunId], references: [id], onDelete: Restrict)
  scanCheckOutcome         ScanCheckOutcome?        @relation(fields: [scanCheckOutcomeId], references: [id], onDelete: SetNull)
  supersedesEvidence       Evidence?               @relation("EvidenceSupersession", fields: [supersedesEvidenceId], references: [id], onDelete: SetNull)
  supersededBy             Evidence[]              @relation("EvidenceSupersession")
  observedFacts            ObservedFact[]
  legalHolds               EvidenceLegalHold[]
  controlResults           ControlResult[]

  @@unique([organizationId, contentHash, type, sourceIntegrationId])
  @@index([organizationId, scanRunId, createdAt])
  @@index([organizationId, contentHash])
  @@index([organizationId, integrityStatus, integrityVerifiedAt])
  @@index([organizationId, retentionUntil, legalHoldStatus])
  @@index([organizationId, legalHoldStatus])
}

model ObservedFact {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  evidenceId      String       @db.Uuid
  provider        String       @db.VarChar(80)
  resourceKey     String       @db.VarChar(512)
  observedAt      DateTime     @db.Timestamptz(3)
  payloadSchema   String       @db.VarChar(80)
  extractedFields Json
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence        Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, provider, resourceKey])
  @@index([organizationId, evidenceId])
  @@index([organizationId, provider, resourceKey])
  @@index([observedAt])
}

model EvidenceLegalHold {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  evidenceId       String                  @db.Uuid
  status            EvidenceLegalHoldStatus @default(ACTIVE)
  reason           String                  @db.VarChar(500)
  createdByUserId  String                  @db.Uuid
  releasedByUserId String?                 @db.Uuid
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  releasedAt       DateTime?               @db.Timestamptz(3)
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence         Evidence                @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  createdBy        User                      @relation("EvidenceHoldCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  releasedBy       User?                     @relation("EvidenceHoldReleasedBy", fields: [releasedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, evidenceId, status])
  @@index([organizationId, status, createdAt])
}

model DomainEvent {
  id             String       @id @default(uuid()) @db.Uuid
  eventType      String       @db.VarChar(120)
  eventVersion   Int          @default(1)
  occurredAt     DateTime     @default(now()) @db.Timestamptz(3)
  actorUserId    String?      @db.Uuid
  organizationId String       @db.Uuid
  entityId       String       @db.Uuid
  entityVersion  Int          @default(1)
  correlationId  String       @db.VarChar(128)
  dataRef        String       @db.VarChar(512)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([entityId, eventType, entityVersion])
  @@index([organizationId, occurredAt])
  @@index([organizationId, eventType, entityId])
}

model ScanEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  scanRunId      String   @db.Uuid
  eventType      String   @db.VarChar(64)
  attempt        Int      @default(1)
  correlationId  String   @db.VarChar(128)
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scanRun        SecurityScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@unique([scanRunId, eventType, attempt])
  @@index([organizationId, createdAt])
  @@index([scanRunId, createdAt])
}

model SecurityFinding {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @db.Uuid
  ruleId           String                  @db.VarChar(80)
  ruleVersion      String                  @db.VarChar(32)
  awsResourceId    String                  @db.Uuid
  accountId        String                  @db.Uuid
  resourceId       String                  @db.VarChar(512)
  resourceType     String                  @db.VarChar(120)
  awsAccountId     String                  @db.VarChar(12)
  region           String                  @db.VarChar(64)
  severity         SecurityFindingSeverity
  status           SecurityFindingStatus   @default(OPEN)
  title            String                  @db.VarChar(255)
  description      String
  evidence         Json
  recommendation   String
  firstDetectedAt  DateTime                @default(now()) @db.Timestamptz(3)
  lastDetectedAt   DateTime                @default(now()) @db.Timestamptz(3)
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolutionReason String?                 @db.VarChar(500)
  discoveryRunId   String?                 @db.Uuid
  scanRunId        String                  @db.Uuid
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  resource         AwsResource             @relation(fields: [awsResourceId], references: [id], onDelete: Restrict)
  account          AwsAccount              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  discoveryRun     DiscoveryRun?           @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)
  scanRun          SecurityScanRun         @relation(fields: [scanRunId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ruleId, ruleVersion, awsAccountId, region, resourceId])
  @@index([organizationId, status, severity, lastDetectedAt])
  @@index([organizationId, ruleId, resourceType])
  @@index([organizationId, awsAccountId, region])
  @@index([organizationId, accountId, status])
  @@index([resourceId])
}
