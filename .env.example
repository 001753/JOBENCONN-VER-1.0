# JOBEN Enterprise environment contract
# Copy to .env for local use. Never commit real secrets.

# REQUIRED in production; optional in development/test.
DATABASE_URL=

# Optional until identity/encryption is implemented in a later work package.
# Must be a high-entropy secret when enabled; never use an example value.
SESSION_SECRET=

# Optional. Defaults are explicit and safe for local development.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info