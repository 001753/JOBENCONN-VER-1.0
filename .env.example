# JOBEN Enterprise environment contract
# Copy to .env for local use. Never commit real secrets.

# REQUIRED in production; optional in development/test.
DATABASE_URL=

# Optional until identity/encryption is implemented in a later work package.
# Must be a high-entropy secret when enabled; never use an example value.
SESSION_SECRET=

# Authentication provider. "dev" is a test/dev adapter and is disabled in production.
AUTH_PROVIDER=dev
# Required only when AUTH_PROVIDER=clerk; Clerk integration remains verification-required
# until a verified SDK adapter and provider connection are configured.
CLERK_SECRET_KEY=
SESSION_TTL_SECONDS=28800

# Optional. Defaults are explicit and safe for local development.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info

# Optional AWS SDK default region. Credentials are resolved by the AWS SDK chain;
# never place AWS secret keys in this file.
AWS_REGION=us-east-1