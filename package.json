{
  "name": "joben-enterprise",
  "version": "0.1.0",
  "private": true,
  "description": "JOBEN Enterprise repository baseline and P0 readiness foundation",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && NODE_ENV=test node --test dist/test/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1110.0",
    "@aws-sdk/client-iam": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/client-sts": "^3.1110.0",
    "@aws-sdk/credential-providers": "^3.1110.0",
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  }
}
